{
  // YSS 管理动画时间窗、骨骼采样、命中去重和位移。
  // 最终伤害通过 damage_profile 解析，客户端不能发送伤害数字。
  "id": "empyrean:light_slash",
  "animation": "empyrean:combat/light_slash",
  "segments": [
    {
      "id": "main_hit",
      "bones": ["weapon", "right_hand"],
      "time": {"start": 0.18, "end": 0.32},
      "shape": {"type": "bone_sweep", "radius": 0.8},
      "damage_profile": "empyrean:light_slash",
      "attack_tags": ["melee", "physical"],
      "deduplicate": "target_per_attack",
      "knockback": {"strength": 0.25, "vertical": 0.05}
    }
  ],
  "events": {
    "on_start": ["attack_started"],
    "on_hit": ["hit_confirmed"],
    "on_finish": ["attack_finished"]
  }
}
